{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["runs/**", "coverage/**", ".claude/**"],
  "rules": {
    "typescript/await-thenable": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      "files": ["packages/protocol/**", "packages/engine/**", "packages/gateway/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun",
                "message": "Pure package: no Bun APIs (it must run unchanged in a browser)."
              },
              {
                "name": "elysia",
                "message": "Pure package: HTTP lives in the server package."
              }
            ],
            "patterns": [
              {
                "group": ["bun:*"],
                "message": "Pure package: no Bun APIs (it must run unchanged in a browser)."
              },
              {
                "group": ["node:*"],
                "message": "Pure package: no Node APIs (it must run unchanged in a browser)."
              },
              {
                "group": ["@elysiajs/*"],
                "message": "Pure package: HTTP lives in the server package."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "No wall-clock time in pure packages: use integer game-seconds from the engine."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Use the engine's seeded PRNG so matches replay identically."
          }
        ]
      }
    },
    {
      "files": [
        "packages/protocol/**/*.test.ts",
        "packages/engine/**/*.test.ts",
        "packages/gateway/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun",
                "message": "Pure package tests: only bun:test is allowed."
              },
              {
                "name": "elysia",
                "message": "Pure package: HTTP lives in the server package."
              }
            ],
            "patterns": [
              {
                "group": ["bun:*", "!bun:test"],
                "message": "Pure package tests: only bun:test is allowed."
              },
              {
                "group": ["node:*"],
                "message": "Pure package: no Node APIs."
              },
              {
                "group": ["@elysiajs/*"],
                "message": "Pure package: HTTP lives in the server package."
              }
            ]
          }
        ]
      }
    }
  ]
}
